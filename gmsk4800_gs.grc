- [blocks_stream_to_tagged_stream_cw, '0', pdu_tagged_stream_to_pdu_cw, '0']
- [dc_blocker_xx_0, '0', low_pass_filter_bb, '0']
- [digital_binary_slicer_fb_0, '0', blocks_pack_k_bits_bb_0, '0']
