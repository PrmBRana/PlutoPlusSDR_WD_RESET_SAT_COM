- [low_pass_filter_0, '0', digital_gfsk_demod_0, '0']
- [low_pass_filter_0, '0', qtgui_freq_sink_x_0, '0']
- [low_pass_filter_bb, '0', digital_symbol_sync_xx_0, '0']
- [network_socket_pdu_tx, pdus, pdu_pdu_to_tagged_stream_0, pdus]
- [pdu_pdu_to_tagged_stream_0, '0', digital_gfsk_mod_0, '0']
- [pdu_tagged_stream_to_pdu_0, pdus, network_socket_pdu_rx, pdus]
- [pdu_tagged_stream_to_pdu_cw, pdus, network_socket_pdu_cw, pdus]
- [rational_resampler_xxx_0, '0', blocks_rotator_cc_0, '0']

metadata:
  file_format: 1
