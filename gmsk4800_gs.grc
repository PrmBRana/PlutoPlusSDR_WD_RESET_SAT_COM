- name: rational_resampler_xxx_0
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: Upsample 48 kS/s -> 960 kS/s with gain=20 (fixes -26 dB zero-stuffing loss)
    decim: '1'
    fbw: '0'
    interp: resamp_factor
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: firdes.low_pass(resamp_factor, samp_rate, 12000, 8000)
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 44.0]
    rotation: 0
    state: enabled
